DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Optional: set only after ALVIRA and Bridge use sibling custom subdomains, e.g. .alvira.ai.
ALVIRA_SESSION_COOKIE_DOMAIN=
PUBLIC_SITE_URL=http://localhost:3000
OPENAI_API_KEY=
RESEND_API_KEY=
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=ALVIRA <hello@example.com>
# Preferred production mail transport: AgentMail inbox-scoped key with read + send permission.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=alvira@agentmail.to
AGENTMAIL_FROM=ALVIRA <alvira@agentmail.to>
# Signing secret (whsec_...) for the inbox-scoped AgentMail message.received webhook.
AGENTMAIL_WEBHOOK_SECRET=
BETA_FEEDBACK_EMAIL=alvira@agentmail.to
VERCEL_TOKEN=
