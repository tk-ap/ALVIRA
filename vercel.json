{
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/bridge/oauth/resource-metadata"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/bridge/mcp",
      "destination": "/api/bridge/oauth/resource-metadata"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/bridge/oauth/authorization-server"
    }
  ]
}
